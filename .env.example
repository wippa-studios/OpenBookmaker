# OpenBookmaker configuration - copy to .env and adjust.
# All money is integer cents. Paper money only.

# Server
PORT=7777
HOST=127.0.0.1
DB_PATH=data/openbookmaker.db

# Commission charged on net winnings per user per market (0 - 0.2)
COMMISSION_RATE=0.025

# Faucet deposit cap per request (cents)
FAUCET_MAX_CENTS=100000

# Bet size limits (cents)
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=100000

# Demo liquidity bots + price drift (the exchange stays live without a trader)
BOT_ENABLED=true
DRIFT_ENABLED=true
DRIFT_INTERVAL_MS=5000

# Sessions
SESSION_TTL_DAYS=30
